# Copiar como .env y completar. El .env NO se sube a GitHub.
# Dirección que los brokers anuncian a los microservicios:
#   host.docker.internal en el PC cuando las apps también corren en Docker (igual que KAFKA_HOST de apps/.env)
#   localhost solo si las apps corren fuera de Docker (mvnw spring-boot:run) · IP privada de ec2-kafka en AWS (UserData)
KAFKA_HOST=host.docker.internal
# Login de Kafka UI (http://localhost:8080). Usar solo letras y números
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=CambiarKafkaUi123

# Memoria de cada broker (opcional). Sin esta línea: -Xms256m -Xmx512m.
# En un notebook con 6 GB para Docker conviene bajarla:
# KAFKA_BROKER_HEAP=-Xms128m -Xmx256m
