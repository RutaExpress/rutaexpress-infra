                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));",
                      "pm.test(\"Error con ProblemDetail: Transición de estado no permitida\", () => pm.expect(pm.response.json().title).to.eql(\"Transición de estado no permitida\"));"
                    ]
                  }
                }
              ]
            },
