{
  "info": {
    "_postman_id": "cbd7c956-718b-43a0-a960-110bd2aa18f8",
    "name": "Ruta Express",
    "description": "Pruebas locales de RutaExpress en Docker (notebook de pruebas), antes de AWS. Llama directo a cada microservicio en 127.0.0.1, sin token (el BFF, el front y Entra ID se prueban en AWS). Correr en orden: cada carpeta es una prueba del plan (P1 a P15) del artefacto «RutaExpress: mapa del sistema».",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Etapa 1 · Flujo del caso (shipments, notify, report, audit)",
      "item": [
        {
          "name": "P1 a P5 · Flujo del envío (shipments)",
          "description": "Un envío de punta a punta. Crear guarda el id en {{shipmentId}} para las siguientes. Evidencia: Kafka UI (shipments.events y audit.timeline +1 por paso, lag 0 en report y audit), consola de RabbitMQ (desde ACEPTADO) y docker logs rx-notify.",
          "item": [
            {
              "name": "P1 · Crear envío",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-User-Id",
                    "value": "{{clienteId}}",
                    "description": "oid del cliente: en producción lo pone el BFF desde el token"
                  }
                ],
                "url": "{{shipmentsUrl}}/api/v1/shipments",
                "description": "Crea un envío en CREADO. Publica 2 eventos en Kafka (shipments.events y audit.timeline) y ningún comando en RabbitMQ.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"serviceId\": \"svc-express\",\n  \"originAddress\": \"Av. Providencia 1234, Santiago\",\n  \"destinationAddress\": \"Calle Prat 456, Valparaíso\",\n  \"recipientName\": \"Ana Pérez\",\n  \"recipientEmail\": \"ana.perez@example.com\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const envio = pm.response.json();",
                      "pm.collectionVariables.set(\"shipmentId\", envio.id);",
                      "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                      "pm.test(\"Nace en CREADO con tracking RX-\", () => {",
                      "    pm.expect(envio.status).to.eql(\"CREADO\");",
                      "    pm.expect(envio.trackingNumber).to.match(/^RX-/);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "P1 · Ver el envío creado",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{shipmentsUrl}}/api/v1/shipments/{{shipmentId}}",
                "description": "Lee el envío desde Oracle."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "P2 · ACEPTADO",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-User-Id",
                    "value": "{{operadorId}}",
                    "description": "oid del operador que cambia el estado (queda como actor en audit)"
                  }
                ],
                "url": "{{shipmentsUrl}}/api/v1/shipments/{{shipmentId}}/status",
                "description": "Cambia el envío a ACEPTADO. RabbitMQ: comandos a q.cmd.email y q.cmd.warehouse; notify registra [EMAIL] y [TICKET] creado.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"ACEPTADO\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                      "pm.test(\"Queda en ACEPTADO\", () => pm.expect(pm.response.json().status).to.eql(\"ACEPTADO\"));"
                    ]
