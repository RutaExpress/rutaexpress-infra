                    "description": "oid del operador que cambia el estado (queda como actor en audit)"
                  }
                ],
                "url": "{{shipmentsUrl}}/api/v1/shipments/{{shipmentId}}/status",
                "description": "ENTREGADO es final: 409 con ProblemDetail y sin eventos nuevos en Kafka ni comandos en RabbitMQ.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"EN_RUTA\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
