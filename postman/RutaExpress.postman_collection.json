        {
          "name": "P6 · Reglas y errores de shipments",
          "item": [
            {
              "name": "P6 · Transición inválida (ENTREGADO → EN_RUTA)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
