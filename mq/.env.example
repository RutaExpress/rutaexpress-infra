# Copiar como .env y completar. Usar solo letras y números. El .env NO se sube a GitHub.
# Cookie de Erlang: secreto compartido por los 2 nodos para formar el clúster
RABBITMQ_ERLANG_COOKIE=CambiarPorUnaCookieLarga123
# Contraseñas de los usuarios RabbitMQ (se guardan como hash en definitions.json)
RX_ADMIN_PASSWORD=CambiarAdmin123
RX_OPS_PASSWORD=CambiarOps123
RX_SHIPMENTS_PASSWORD=CambiarShipments123
RX_NOTIFY_PASSWORD=CambiarNotify123
